# Database
POSTGRES_PASSWORD=provision123

# Backend
# ОБЯЗАТЕЛЬНО замените на собственный секрет (минимум 32 символа).
# Без JWT_SECRET стек не запустится: docker compose упадёт сразу,
# а бэкенд дополнительно проверит секрет при старте (fail-fast).
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_your_own_secret_at_least_32_chars

# CORS: origins, которым разрешено обращаться к API напрямую (без nginx-прокси).
# По умолчанию уже разрешены http://localhost:3000 и http://localhost:5173.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (подставляются при СБОРке фронта, не в рантайме)
VITE_API_URL=/api/v1
VITE_API_MODE=auto

# Росстат / ЕМИСС (опционально — дефолты рабочие): официальные средние потребительские
# цены на товары (fedstat.ru). Ключи и пароли НЕ нужны. Кнопка «Синхронизировать» в разделе
# «Интеграции» скачивает выгрузку и укладывает её в локальную копию БД (emis_products /
# emis_prices); привязка продукта к позиции ЕМИСС и цены читаются уже из нашей БД.
# ROSSTAT_INDICATOR_ID: 31448 = «Средние потребительские цены на товары и
#   услуги» (ежемесячно); 37426 = еженедельные цены.
# ROSSTAT_REGION: название региона из справочника ОКАТО (уходит в форму выгрузки).
# ROSSTAT_REGION_CODE: код того же региона (под ним точки хранятся в emis_prices).
# ROSSTAT_PERIOD_YEARS: сколько последних лет храним в локальной копии (дефолт 2).
# ROSSTAT_PERIOD_MONTHS: сколько последних месяцев запрашивать у портала (ось «Период»);
#   0 = все 12. Сужать поле «Год» НЕЛЬЗЯ: портал отвечает на это 302 (проверено 28.10.2026),
#   поэтому год уходит целиком, а окно хранения режется по PERIOD_YEARS.
# ROSSTAT_MAX_RESPONSE_BYTES: предохранитель от runaway-ответа — при превышении чтение
#   ОБРЫВАЕТСЯ (разбор потоковый, память от объёма не зависит: 66 МБ разбирались в 128 МБ heap).
#   Дефолт 96 МБ держит полный ряд ЕМИСС (65 МБ) с запасом.
# EMIS_UPLOAD_MAX_FILE_SIZE: лимит ручной загрузки выгрузки («Интеграции» → «Загрузить
#   выгрузку ЕМИСС вручную»). Должен совпадать с client_max_body_size в nginx.conf (96m).
# BACKEND_MEM_LIMIT: лимит памяти контейнера бэкенда (дефолт 1g); heap считается от него
#   в Dockerfile (-XX:MaxRAMPercentage=70.0).
# INTEGRATION_CONTACT_EMAIL: контакт для User-Agent (вежливость публичных API).
# ВНИМАНИЕ: ЕМИСС блокирует зарубежные дата-центры (403 анти-бот) — работает из сети РФ.
# Если портал недоступен, приложение не ломается: справочник и цены региона 643004.АГ
# засеяны миграцией V27 из реальной выгрузки.
# НЕ коммитить реальные значения — этот файл только шаблон.
# ROSSTAT_INDICATOR_ID=31448
# ROSSTAT_REGION=Российская Федерация без учета новых субъектов (с 01.01.2023)
# ROSSTAT_REGION_CODE=643004.АГ
# ROSSTAT_PERIOD_YEARS=2
# ROSSTAT_PERIOD_MONTHS=0
# ROSSTAT_MAX_RESPONSE_BYTES=100663296
# EMIS_UPLOAD_MAX_FILE_SIZE=96MB
# BACKEND_MEM_LIMIT=1g
# INTEGRATION_CONTACT_EMAIL=you@example.com

# Демо-данные (только профиль dev): создать тестовых пользователей
# admin@provision.app / user@provision.app (пароль provision123) и три
# наполненных демо-похода: горы (прошедший, с ценами план/факт и заменой),
# яхта Хорватия (7 дней), ПВД в Карелии (2 дня).
# ВНИМАНИЕ: для деплоя на публичный сервер установите false —
# пароли демо-учёток открыты в репозитории.
SEED_DEMO_USERS=true
