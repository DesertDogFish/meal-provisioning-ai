# Database
POSTGRES_PASSWORD=provision123

# Backend
# ОБЯЗАТЕЛЬНО замените на собственный секрет (минимум 32 символа).
# Без JWT_SECRET стек не запустится: docker compose упадёт сразу,
# а бэкенд дополнительно проверит секрет при старте (fail-fast).
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_your_own_secret_at_least_32_chars

# CORS: origins, которым разрешено обращаться к API напрямую (без nginx-прокси).
# По умолчанию уже разрешены http://localhost:3000 и http://localhost:5173.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (подставляются при СБОРке фронта, не в рантайме)
VITE_API_URL=/api/v1
VITE_API_MODE=auto

# Open Food Facts (опционально): учётная запись на world.openfoodfacts.org.
# Нужна для обхода лимитов анонимных запросов (503/429) при поиске продуктов.
# ВАЖНО (дока OFF): OFF_USER_ID — это USERNAME аккаунта, НЕ email
# («user_id is the username of your account. You must not use your email
# address»). Username виден в профиле на world.openfoodfacts.org.
# OFF_CONTACT_EMAIL — контакт для User-Agent (формат OFF «AppName/Version
# (ContactEmail)»); не задан — берётся дефолтный.
# OFF_PROXY_URL — опциональный прокси для запросов OFF (http://host:port или
# socks5://host:port). Нужен, если провайдер режет TLS до search.openfoodfacts.org
# (ошибка «Remote host terminated the handshake» / curl (35)). Из контейнера
# прокси на хост-машине доступен как http://host.docker.internal:PORT.
# Без кредов бэкенд работает в анонимном режиме (WARN "OFF credentials not set" в логах).
# НЕ коммитить реальные значения — этот файл только шаблон.
# OFF_USER_ID=your_off_username
# OFF_PASSWORD=your_off_password
# OFF_CONTACT_EMAIL=you@example.com
# OFF_PROXY_URL=http://host.docker.internal:1080

# Демо-данные (только профиль dev): создать тестовых пользователей
# admin@provision.app / user@provision.app (пароль provision123) и три
# наполненных демо-похода: горы (прошедший, с ценами план/факт и заменой),
# яхта Хорватия (7 дней), ПВД в Карелии (2 дня).
# ВНИМАНИЕ: для деплоя на публичный сервер установите false —
# пароли демо-учёток открыты в репозитории.
SEED_DEMO_USERS=true
