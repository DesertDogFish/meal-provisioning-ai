# Database
POSTGRES_PASSWORD=provision123

# Backend
# ОБЯЗАТЕЛЬНО замените на собственный секрет (минимум 32 символа).
# Без JWT_SECRET стек не запустится: docker compose упадёт сразу,
# а бэкенд дополнительно проверит секрет при старте (fail-fast).
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_your_own_secret_at_least_32_chars

# CORS: origins, которым разрешено обращаться к API напрямую (без nginx-прокси).
# По умолчанию уже разрешены http://localhost:3000 и http://localhost:5173.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (подставляются при СБОРке фронта, не в рантайме)
VITE_API_URL=/api/v1
VITE_API_MODE=auto

# Росстат / ЕМИСС (Fix-13, опционально — дефолты рабочие): официальные средние
# потребительские цены на продукты (fedstat.ru). Ключи и пароли НЕ нужны.
# ROSSTAT_INDICATOR_ID: 31448 = «Средние потребительские цены на товары и
#   услуги» (ежемесячно); 37426 = еженедельные цены.
# ROSSTAT_REGION: значение из справочника ОКАТО (например «Белгородская область»).
# ROSSTAT_CACHE_HOURS: TTL кэша выгрузки (данные обновляются раз в месяц).
# INTEGRATION_CONTACT_EMAIL: контакт для User-Agent (вежливость публичных API).
# ВНИМАНИЕ: ЕМИСС блокирует зарубежные дата-центры (403 анти-бот) — работает
# из сети РФ. Интеграция Open Food Facts демонтирована (Fix-13): её поисковый
# хост недостижим из сети пользователя (TLS-блокировка провайдера).
# НЕ коммитить реальные значения — этот файл только шаблон.
# ROSSTAT_INDICATOR_ID=31448
# ROSSTAT_REGION=Российская Федерация
# ROSSTAT_CACHE_HOURS=24
# INTEGRATION_CONTACT_EMAIL=you@example.com

# Демо-данные (только профиль dev): создать тестовых пользователей
# admin@provision.app / user@provision.app (пароль provision123) и три
# наполненных демо-похода: горы (прошедший, с ценами план/факт и заменой),
# яхта Хорватия (7 дней), ПВД в Карелии (2 дня).
# ВНИМАНИЕ: для деплоя на публичный сервер установите false —
# пароли демо-учёток открыты в репозитории.
SEED_DEMO_USERS=true
