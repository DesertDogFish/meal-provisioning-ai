{
  "brand": "Провиант",
  "version": "1.1",
  "description": "Машинно-читаемые токены айдентики. Источник правды для кодинг-агентов; tokens.css генерируется из этого файла (держите синхронно).",
  "themes": {
    "dark": {
      "default": true,
      "bg": { "0": "#0B141B", "1": "#101D27", "2": "#162634", "3": "#1E3243" },
      "line": { "base": "rgba(148,199,214,.14)", "strong": "rgba(148,199,214,.28)" },
      "text": { "1": "#EDF4F7", "2": "#A9BEC9", "3": "#6F8895" },
      "fire": { "200": "#FFD9A0", "300": "#FFC46B", "500": "#FF9E2C", "600": "#F27A12", "flame": "#E85D1F", "onFire": "#221204" },
      "water": { "300": "#7FD8CC", "400": "#57C7B8", "600": "#2E9C8E" },
      "snow": "#F2F7F5",
      "danger": "#FF6B57",
      "success": "#57C7B8",
      "gradBrand": ["#FFC46B 0%", "#F2842B 52%", "#E85D1F 100%"],
      "shadow1": "0 18px 50px rgba(3,10,16,.5)"
    },
    "light": {
      "default": false,
      "bg": { "0": "#F5F2EB", "1": "#FFFFFF", "2": "#EEEAE1", "3": "#E2DCCE" },
      "line": { "base": "rgba(16,32,43,.12)", "strong": "rgba(16,32,43,.24)" },
      "text": { "1": "#10202B", "2": "#435663", "3": "#75848E" },
      "fire": { "200": "#F9B569", "300": "#D97418", "500": "#D96A10", "600": "#C2570E", "flame": "#C24E12", "onFire": "#FFF8F0" },
      "water": { "300": "#0F7A6E", "400": "#12877A", "600": "#0C6B60" },
      "snow": "#FFFFFF",
      "danger": "#D93A26",
      "success": "#0F7A6E",
      "gradBrand": ["#F79A3E 0%", "#E8622C 55%", "#C24E12 100%"],
      "shadow1": "0 18px 50px rgba(31,42,50,.12)"
    }
  },
  "themeSwitch": {
    "mechanism": "attribute on <html>",
    "attribute": "data-theme",
    "values": ["dark", "light"],
    "default": "dark",
    "persist": "localStorage key 'pv-theme' (try/catch)"
  },
  "radius": { "sm": "12px", "md": "18px", "lg": "26px", "pill": "999px" },
  "typography": {
    "display": { "family": "Unbounded", "fallback": ["Manrope", "system-ui", "sans-serif"], "weights": [500, 700], "usage": "h1-h3, логотип, крупные цифры" },
    "body": { "family": "Manrope", "fallback": ["system-ui", "sans-serif"], "weights": [400, 500, 600, 700, 800], "usage": "всё остальное" },
    "scale": {
      "h1": "clamp(36px, 5.6vw, 64px)",
      "h2": "clamp(24px, 3.2vw, 38px)",
      "h3": "18px",
      "body": "16px/1.6",
      "small": "13-14px",
      "overline": "12px, letter-spacing .16-.22em, uppercase, weight 700"
    }
  },
  "spacing": ["4", "8", "12", "16", "20", "24", "32", "48", "64"],
  "motion": { "fast": ".15s", "base": ".2s", "slow": ".3s", "ease": "cubic-bezier(.4,0,.2,1)", "reduce": "prefers-reduced-motion отключает float/drift/pulse" },
  "zIndex": { "nav": 60, "popover": 40, "modal": 90, "toast": 100 },
  "logo": {
    "assets": {
      "mark": "assets/mark.svg",
      "markLight": "assets/mark-light.svg",
      "markMono": "assets/mark-mono.svg",
      "favicon": "assets/favicon.svg",
      "appIcon": "assets/app-icon.svg",
      "lockup": "assets/logo-horizontal.svg"
    },
    "usage": {
      "darkBackgrounds": "mark.svg",
      "lightBackgrounds": "mark-light.svg (шапка и мачта — вырезы, не белая заливка)",
      "printOneColor": "mark-mono.svg (currentColor)",
      "minSize": { "mark": "24px", "lockup": "120px width" },
      "clearSpace": "1/6 ширины знака с каждой стороны",
      "donts": ["не деформировать", "не перекрашивать парус в холодные тона", "не добавлять свечения/обводки", "не ставить на пёстрый фон без подложки", "не заливать шапку белым на светлом фоне"]
    }
  },
  "a11y": {
    "focusRing": "2px solid var(--amber-500), offset 2px",
    "contrast": [
      ["dark", "text-1 on bg-0", "15.4:1"],
      ["dark", "text-2 on bg-1", "7.9:1"],
      ["light", "text-1 on bg-1", "16.1:1"],
      ["light", "text-2 on bg-1", "7.4:1"]
    ],
    "overlays": "Esc закрывает поповеры и модалки; клик по оверлею закрывает модалку; фокус возвращается на триггер",
    "aria": "switch: role=switch+aria-checked; select: aria-haspopup=listbox; календарь: кнопки с текстом дня; иконки-кнопки: aria-label"
  }
}
