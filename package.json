{
  "name": "meal-provisioning-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:coverage-include": "node scripts/check-coverage-include.mjs",
    "test:watch": "vitest",
    "test:contract": "vitest run contract",
    "test:e2e": "playwright test",
    "typecheck:all": "npm run typecheck && tsc -p tsconfig.e2e.json && tsc -p tsconfig.node.json",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "fake-indexeddb": "^6.2.7",
    "lucide-react": "^1.63.0",
    "react": "^18.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^1.6.1",
    "depcheck": "^1.4.7",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^21.0.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^1.6.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
